GOOGLE_MAPS_API_KEY=

# true en cualquier entorno de prueba/demo (muestra la caja de "usuarios de
# prueba" en el login). Poner en false antes de un despliegue real a producción.
APP_DEMO=true

# SMTP para la feature "Verificaciones" (config/mailer.php). Sin esto configurado,
# la palabra de verificación se genera y guarda igual, simplemente no sale el
# email (falla en silencio a propósito, ver el comentario en mailer.php sobre
# por qué no usa error_log). Para Gmail: host smtp.gmail.com, puerto 587,
# usuario tu cuenta completa, contraseña una "contraseña de aplicación" (no la
# contraseña normal de la cuenta).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Aprilon
