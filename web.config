<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reglas de IIS para este sitio (equivalente a .htaccess en Apache).
  Objetivo: que nada sensible quede servible directo por HTTP, aunque cambie
  la configuración default del servidor.
    - config/ y db/ nunca se piden desde el navegador (todo pasa por
      require_once del lado del PHP), así que se bloquean enteros.
    - uploads/fotos/ SÍ tiene que quedar accesible (las fotos de perfil se
      muestran con <img src>), por eso no se toca esa carpeta acá — solo se
      bloquean extensiones sensibles a nivel de todo el sitio (.env/.sql/.pem/.md),
      que no existen dentro de uploads/.
    - .md bloqueado porque el documento de handoff del proyecto (que sí puede
      vivir en esta misma carpeta compartida, para que el equipo lo encuentre)
      tiene credenciales reales en texto plano — no puede quedar bajable por URL.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config" />
          <add segment="db" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".pem" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".zip" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
